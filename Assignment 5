#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100];
    int choice;

    do
    {
        printf("\n1. String Length");
        printf("\n2. String Copy");
        printf("\n3. String Concatenation");
        printf("\n4. String Comparison");
        printf("\n5. Reverse String");
        printf("\n6. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter a string: ");
                scanf(" %[^\n]", str1);
                printf("Length = %lu", strlen(str1));
                break;

            case 2:
                printf("Enter a string: ");
                scanf(" %[^\n]", str1);
                strcpy(str2, str1);
                printf("Copied string = %s", str2);
                break;

            case 3:
                printf("Enter first string: ");
                scanf(" %[^\n]", str1);
                printf("Enter second string: ");
                scanf(" %[^\n]", str2);
                strcat(str1, str2);
                printf("Concatenated string = %s", str1);
                break;

            case 4:
                printf("Enter first string: ");
                scanf(" %[^\n]", str1);
                printf("Enter second string: ");
                scanf(" %[^\n]", str2);

                if (strcmp(str1, str2) == 0)
                    printf("Strings are equal");
                else
                    printf("Strings are not equal");
                break;

            case 5:
            {
                int i, len;
                char temp;

                printf("Enter a string: ");
                scanf(" %[^\n]", str1);

                len = strlen(str1);

                for (i = 0; i < len / 2; i++)
                {
                    temp = str1[i];
                    str1[i] = str1[len - i - 1];
                    str1[len - i - 1] = temp;
                }

                printf("Reversed string = %s", str1);
                break;
            }

            case 6:
                printf("Exiting program");
                break;

            default:
                printf("Invalid choice");
        }

    } while (choice != 6);

    return 0;
}
